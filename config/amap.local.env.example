# Copy to config/amap.local.env (gitignored), fill locally, never commit.
# Android platform SDK key, bound to app.mileaf.mileaf + debug SHA1.
MILEAF_AMAP_ANDROID_KEY=
# iOS platform SDK key, bound to Bundle ID app.mileaf.mileaf.
# Used by ios/Flutter/AMap.local.xcconfig, not by the Android build.
MILEAF_AMAP_IOS_KEY=
